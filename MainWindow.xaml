<Window x:Class="Hunuh.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hunuh" Height="660" Width="1000" WindowStartupLocation="CenterScreen">
  <Grid>
    <!-- ============ LOGIN ============ -->
    <Border x:Name="LoginPanel" Background="#F4F6FA">
      <Border Width="340" Padding="24" Background="White" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock Text="Hunuh" FontSize="26" FontWeight="Bold"/>
          <TextBlock Text="Sign in to continue" Foreground="Gray" Margin="0,0,0,16"/>
          <TextBlock Text="Username"/>
          <TextBox x:Name="LoginUser" Margin="0,2,0,10" Padding="4"/>
          <TextBlock Text="Password"/>
          <PasswordBox x:Name="LoginPass" Margin="0,2,0,12" Padding="4" KeyDown="LoginPass_KeyDown"/>
          <Button Content="Sign in" Click="SignIn_Click" Padding="0,7"/>
          <TextBlock x:Name="LoginError" Foreground="Firebrick" Margin="0,8,0,0" TextWrapping="Wrap"/>
          <TextBlock Foreground="Gray" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"/>
                    <!-- Text="Demo accounts: admin / Admin123!   teacher / Teacher123!   learner / Learner123!" -->
        </StackPanel>
      </Border>
    </Border>

    <!-- ============ MAIN ============ -->
    <DockPanel x:Name="MainPanel" Visibility="Collapsed">
      <Border DockPanel.Dock="Top" Background="#2B3A55" Padding="12,8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Sign out" Click="SignOut_Click" Padding="12,3"/>
          <TextBlock x:Name="WhoAmI" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <TabControl x:Name="Tabs" Margin="8">

        <!-- LEARN -->
        <TabItem Header="Learn" x:Name="TabLearn">
          <Grid Margin="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,8,0">
              <TextBlock DockPanel.Dock="Top" Text="Lessons" FontWeight="Bold" Margin="0,0,0,4"/>
              <DataGrid x:Name="LearnLessons" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                        SelectionChanged="LearnLessons_SelectionChanged">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Language" Binding="{Binding Language}"/>
                  <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                  <DataGridTextColumn Header="Level" Binding="{Binding Level}"/>
                  <DataGridTextColumn Header="Words" Binding="{Binding WordCount}"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
            <DockPanel Grid.Column="1">
              <Button DockPanel.Dock="Top" Content="Start practice" Click="StartPractice_Click"
                      HorizontalAlignment="Left" Padding="14,4" Margin="0,0,0,6"/>
              <Border x:Name="PracticePanel" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,8,0,0"
                      Padding="12" Background="#F4F6FA" CornerRadius="6">
                <StackPanel>
                  <TextBlock x:Name="PromptText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <DockPanel x:Name="AnswerRow" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="Check" Click="Check_Click" Padding="14,4" Margin="6,0,0,0"/>
                    <TextBox x:Name="AnswerBox" Padding="4" KeyDown="AnswerBox_KeyDown"/>
                  </DockPanel>
                  <TextBlock x:Name="Feedback" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <DataGrid x:Name="LearnWords" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Term" Binding="{Binding Term}"/>
                  <DataGridTextColumn Header="Translation" Binding="{Binding Translation}"/>
                  <DataGridTextColumn Header="Example" Binding="{Binding Example}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Grid>
        </TabItem>

        <!-- PROGRESS -->
        <TabItem Header="My progress" x:Name="TabProgress">
          <DataGrid x:Name="ProgressGrid" Margin="8" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=yyyy-MM-dd HH:mm}"/>
              <DataGridTextColumn Header="Lesson" Binding="{Binding LessonTitle}" Width="*"/>
              <DataGridTextColumn Header="Score" Binding="{Binding Result}"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>

        <!-- MANAGE LESSONS (Teacher, Admin) -->
        <TabItem Header="Manage lessons" x:Name="TabManage">
          <Grid Margin="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,8,0">
              <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,4,0"><TextBlock Text="Language"/><TextBox x:Name="NewLang" Padding="3"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,4,0"><TextBlock Text="Title"/><TextBox x:Name="NewTitle" Padding="3"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="Level"/>
                    <ComboBox x:Name="NewLevel" SelectedIndex="0">
                      <ComboBoxItem Content="Beginner"/><ComboBoxItem Content="Intermediate"/><ComboBoxItem Content="Advanced"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="Add lesson" Click="AddLesson_Click" Padding="12,4"/>
                  <Button Content="Delete selected" Click="DeleteLesson_Click" Padding="12,4" Margin="8,0,0,0"/>
                </StackPanel>
              </StackPanel>
              <DataGrid x:Name="ManageLessons" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                        SelectionChanged="ManageLessons_SelectionChanged">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Language" Binding="{Binding Language}"/>
                  <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                  <DataGridTextColumn Header="Level" Binding="{Binding Level}"/>
                  <DataGridTextColumn Header="Words" Binding="{Binding WordCount}"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
            <DockPanel Grid.Column="1">
              <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,4,0"><TextBlock Text="Term"/><TextBox x:Name="NewTerm" Padding="3"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,4,0"><TextBlock Text="Translation (use / for alternatives)"/><TextBox x:Name="NewTrans" Padding="3"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="Example"/><TextBox x:Name="NewExample" Padding="3"/></StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="Add word" Click="AddWord_Click" Padding="12,4"/>
                  <Button Content="Remove selected word" Click="RemoveWord_Click" Padding="12,4" Margin="8,0,0,0"/>
                </StackPanel>
              </StackPanel>
              <DataGrid x:Name="ManageWords" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Term" Binding="{Binding Term}"/>
                  <DataGridTextColumn Header="Translation" Binding="{Binding Translation}"/>
                  <DataGridTextColumn Header="Example" Binding="{Binding Example}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Grid>
        </TabItem>

        <!-- USERS (Admin) -->
        <TabItem Header="Users" x:Name="TabUsers">
          <DockPanel Margin="8">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,4,0"><TextBlock Text="Username"/><TextBox x:Name="UUser" Padding="3"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,4,0"><TextBlock Text="Display name"/><TextBox x:Name="UDisplay" Padding="3"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,4,0"><TextBlock Text="Password (min 8; also used for reset)"/><PasswordBox x:Name="UPass" Padding="3"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="Role"/><ComboBox x:Name="URole"/></StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Create user" Click="CreateUser_Click" Padding="12,4"/>
                <Button Content="Set role of selected" Click="SetRole_Click" Padding="12,4" Margin="8,0,0,0"/>
                <Button Content="Activate / deactivate" Click="ToggleActive_Click" Padding="12,4" Margin="8,0,0,0"/>
                <Button Content="Reset password" Click="ResetPw_Click" Padding="12,4" Margin="8,0,0,0"/>
              </StackPanel>
            </StackPanel>
            <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}"/>
                <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="Role" Binding="{Binding Role}"/>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive, Mode=OneWay}"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
      </TabControl>
    </DockPanel>
  </Grid>
</Window>
